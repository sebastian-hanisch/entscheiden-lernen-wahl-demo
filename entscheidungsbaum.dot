digraph entscheidungsbaum {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, label="Welches Verfahren? Fragen links, Blätter rechts mit dem Stück der Linie", labelloc=t];
  node [fontname="Helvetica", fontsize=14, style=filled, fillcolor="#ffffff", color="#555555", target="_blank"];
  edge [fontname="Helvetica", fontsize=12, color="#777777"];
  art [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Was wird entschieden?", URL="https://sebastianhanisch-regret-statt-fehler-demo.streamlit.app/", tooltip="Frage: Was wird entschieden?"];
  form [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Ist der Mittelwert linear in\nden Merkmalen?", URL="https://sebastianhanisch-regret-statt-fehler-demo.streamlit.app/", tooltip="Frage: Ist der Mittelwert linear in den Merkmalen?"];
  schief [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Sind die Kosten schief\n(τ ≠ 0,5)?", URL="https://sebastianhanisch-regret-statt-fehler-demo.streamlit.app/", tooltip="Frage: Sind die Kosten schief (τ ≠ 0,5)?"];
  streuung [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Hängt die Streuung von x ab?", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Frage: Hängt die Streuung von x ab?"];
  daten [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Gibt es mindestens\n10·(p + 1) Fälle?", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Frage: Gibt es mindestens 10·(p + 1) Fälle?"];
  linear [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Trifft ein lineares Modell\ndie Kosten?", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Frage: Trifft ein lineares Modell die Kosten?"];
  modell [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Darf das Modell flexibel\nsein?", URL="https://sebastianhanisch-zweistufig-oder-integriert-demo.streamlit.app/", tooltip="Frage: Darf das Modell flexibel sein?"];
  loeser [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Was ist über den Löser\nbekannt?", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Frage: Was ist über den Löser bekannt?"];
  rauschen [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Rauschen und Zahl der\nTrainingsfälle?", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Frage: Rauschen und Zahl der Trainingsfälle?"];
  bb_rauschen [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Sind die Ziele sauber?", URL="https://sebastianhanisch-blackbox-loeser-demo.streamlit.app/", tooltip="Frage: Sind die Ziele sauber?"];
  garantie [shape=box, style="rounded,filled", fillcolor="#ffffff", label="Wird eine Garantie für die\nKosten der gewählten\nEntscheidung verlangt?", URL="https://sebastianhanisch-entscheidungs-schranke-demo.streamlit.app/", tooltip="Frage: Wird eine Garantie für die Kosten der gewählten Entscheidung verlangt?"];
  mittel [shape=box, fillcolor="#f3f3f3", label="Mittel bestellen genügt\nStück 1", URL="https://sebastianhanisch-regret-statt-fehler-demo.streamlit.app/", tooltip="Stück 1: Regret statt Fehler"];
  kq [shape=box, fillcolor="#f3f3f3", label="KQ plus Quantil der\nResiduen\nStück 2", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Stück 2: Direkt auf den Kosten lernen"];
  direkt [shape=box, fillcolor="#f3f3f3", label="direkt (Quantilregression)\nStück 2", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Stück 2: Direkt auf den Kosten lernen"];
  kq_wenig [shape=box, fillcolor="#f3f3f3", label="KQ plus Quantil der\nResiduen (zu wenig Fälle\nfür direkt)\nStück 2", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Stück 2: Direkt auf den Kosten lernen"];
  blind [shape=box, fillcolor="#f3f3f3", label="blinder Fleck: die\nDiagnose sieht es nicht\nStück 2", URL="https://sebastianhanisch-newsvendor-direkt-demo.streamlit.app/", tooltip="Stück 2: Direkt auf den Kosten lernen"];
  gewichte [shape=box, fillcolor="#f3f3f3", label="Gewichte aus Ähnlichkeit\n(kNN, Kern, Wald)\nStück 5", URL="https://sebastianhanisch-gewichtete-stichprobe-demo.streamlit.app/", tooltip="Stück 5: Gewichtete Stichprobe"];
  kq_gitter [shape=box, fillcolor="#f3f3f3", label="Kleinste Quadrate (SPO+\ngewinnt hier nicht)\nStück 3", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Stück 3: SPO+ am kürzesten Weg"];
  kern [shape=box, fillcolor="#f3f3f3", label="flexibles Modell\n(Gauß-Kern-Ridge,\nKern-ETO)\nStück 4", URL="https://sebastianhanisch-zweistufig-oder-integriert-demo.streamlit.app/", tooltip="Stück 4: Zweistufig oder integriert"];
  spo [shape=box, fillcolor="#f3f3f3", label="SPO+ (ohne Rauschen)\nStück 3", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Stück 3: SPO+ am kürzesten Weg"];
  spo_rausch [shape=box, fillcolor="#f3f3f3", label="SPO+ (mit Rauschen, genug\nFälle)\nStück 3", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Stück 3: SPO+ am kürzesten Weg"];
  spo_wenig [shape=box, fillcolor="#f3f3f3", label="Kleinste Quadrate behalten\n(SPO+ lohnt hier nicht)\nStück 3", URL="https://sebastianhanisch-spo-kuerzester-weg-demo.streamlit.app/", tooltip="Stück 3: SPO+ am kürzesten Weg"];
  glaettung [shape=box, fillcolor="#f3f3f3", label="Gibbs-Glättung des Lösers\nStück 6", URL="https://sebastianhanisch-nullgradient-glaettung-demo.streamlit.app/", tooltip="Stück 6: Warum der Gradient fehlt: Glättung"];
  stoerung [shape=box, fillcolor="#f3f3f3", label="gestörte Lösung\n(Fenchel-Young)\nStück 7", URL="https://sebastianhanisch-gestoerte-optimierer-demo.streamlit.app/", tooltip="Stück 7: Gestörte Optimierer"];
  blackbox [shape=box, fillcolor="#f3f3f3", label="Black-Box-Interpolation\n(nur mit sauberen Zielen)\nStück 8", URL="https://sebastianhanisch-blackbox-loeser-demo.streamlit.app/", tooltip="Stück 8: Der Löser als Black Box"];
  blackbox_rausch [shape=box, fillcolor="#f3f3f3", label="Black-Box-Interpolation\nscheitert bei verrauschten\nZielen\nStück 8", URL="https://sebastianhanisch-blackbox-loeser-demo.streamlit.app/", tooltip="Stück 8: Der Löser als Black Box"];
  schranke [shape=box, fillcolor="#f3f3f3", label="konforme Schranke auf den\nWert der Entscheidung\nStück 9", URL="https://sebastianhanisch-entscheidungs-schranke-demo.streamlit.app/", tooltip="Stück 9: Eine Schranke für die Entscheidung"];
  art -> form [label="Menge je Fall"];
  art -> linear [label="Löser"];
  form -> schief [label="ja"];
  form -> gewichte [label="nein"];
  schief -> mittel [label="nein"];
  schief -> streuung [label="ja"];
  streuung -> kq [label="nein"];
  streuung -> daten [label="ja, linear"];
  streuung -> blind [label="ja, nicht monoton"];
  daten -> direkt [label="ja"];
  daten -> kq_wenig [label="nein"];
  linear -> kq_gitter [label="ja"];
  linear -> modell [label="nein"];
  modell -> kern [label="flexibel"];
  modell -> loeser [label="linear"];
  loeser -> rauschen [label="Ersatzverlust"];
  loeser -> glaettung [label="Wege aufzählbar"];
  loeser -> stoerung [label="nur Aufrufe, Störung"];
  loeser -> bb_rauschen [label="nur Aufrufe, Interpolation"];
  rauschen -> spo [label="ohne Rauschen"];
  rauschen -> spo_rausch [label="Rauschen, n = 1000"];
  rauschen -> spo_wenig [label="Rauschen, n = 100"];
  bb_rauschen -> blackbox [label="sauber"];
  bb_rauschen -> blackbox_rausch [label="verrauscht"];
  garantie -> schranke [label="ja", style=dashed];
  art -> garantie [label="zusätzlich", style=dashed, color="#777777"];
}
